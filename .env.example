# Copy this file to ".env" and fill in ONE provider. Nothing else is needed.

# Which way to reach the AI:  openrouter | openai | anthropic | claude-cli | codex-cli
LLM_PROVIDER=openrouter

# --- openrouter (one key, many models) ---
OPEN_ROUTER_API_KEY=
OPEN_ROUTER_MODEL=openai/gpt-4o

# --- openai (a custom OPENAI_BASE_URL also works for local models such as Ollama / LM Studio) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# --- anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- claude-cli / codex-cli: no key here, just be logged in to the CLI ---
# CLAUDE_CMD=claude
# CODEX_CMD=codex

# --- MongoDB (accounts, canvases, images, textbooks, history) ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=think_canvas

# --- behaviour ---
AUTO_ASK_DELAY_MS=2500      # pause after writing before the AI reads it
MAX_OUTPUT_TOKENS=700       # cap on every AI reply (keeps cost down)
ASK_RATE_PER_MIN=20         # AI calls per user per minute
AUTH_RATE_PER_MIN=10        # login / register attempts per minute

# --- server and logs ---
PORT=3888
LOG_LEVEL=INFO              # DEBUG to also log every static file request
# LOG_DIR=logs

# --- voice: live speech-to-text (AssemblyAI) ---
ASSEMBLYAI_API_KEY=
STT_AUTOSUBMIT_SILENCE_MS=5000

# --- voice: Live Session tutor (Gemini Live) ---
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=models/gemini-2.5-flash-native-audio-preview-12-2025
