        <mxCell id="r_c_hist" value="1               0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;strokeColor=#000000;fontFamily=Arial;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ent_canvases" target="ent_history"><mxGeometry relative="1" as="geometry"/></mxCell>
