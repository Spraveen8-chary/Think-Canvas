        <mxCell id="e_hist_mongo" style="endArrow=none;html=0;strokeColor=#000000;strokeWidth=1;rounded=0;" edge="1" parent="1" source="uc_history" target="actor_mongo"><mxGeometry relative="1" as="geometry"/></mxCell>
