        <mxCell id="e_u_canv" style="endArrow=none;html=0;strokeColor=#000000;strokeWidth=1;rounded=0;" edge="1" parent="1" source="actor_user" target="uc_canvas_crud"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_u_draw" style="endArrow=none;html=0;strokeColor=#000000;strokeWidth=1;rounded=0;" edge="1" parent="1" source="actor_user" target="uc_draw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_u_img" style="endArrow=none;html=0;strokeColor=#000000;strokeWidth=1;rounded=0;" edge="1" parent="1" source="actor_user" target="uc_import_img"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_u_lib" style="endArrow=none;html=0;strokeColor=#000000;strokeWidth=1;rounded=0;" edge="1" parent="1" source="actor_user" target="uc_library"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_u_hist" style="endArrow=none;html=0;strokeColor=#000000;strokeWidth=1;rounded=0;" edge="1" parent="1" source="actor_user" target="uc_history"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_u_find" style="endArrow=none;html=0;strokeColor=#000000;strokeWidth=1;rounded=0;" edge="1" parent="1" source="actor_user" target="uc_find"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Include / Extend Relationships -->
        <mxCell id="e_draw_ask" value="&lt;&lt;extend&gt;&gt;" style="endArrow=open;endSize=10;dashed=1;html=0;strokeColor=#000000;strokeWidth=1;fontFamily=Arial;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="uc_ask" target="uc_draw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_ask_render" value="&lt;&lt;include&gt;&gt;" style="endArrow=open;endSize=10;dashed=1;html=0;strokeColor=#000000;strokeWidth=1;fontFamily=Arial;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="uc_ask" target="uc_render"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_ask_rag" value="&lt;&lt;extend&gt;&gt;" style="endArrow=open;endSize=10;dashed=1;html=0;strokeColor=#000000;strokeWidth=1;fontFamily=Arial;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="uc_rag_search" target="uc_ask"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Secondary Actor Associations -->
        <mxCell id="e_ask_llm" style="endArrow=none;html=0;strokeColor=#000000;strokeWidth=1;rounded=0;" edge="1" parent="1" source="uc_ask" target="actor_llm"><mxGeometry relative="1" as="geometry"/></mxCell>
