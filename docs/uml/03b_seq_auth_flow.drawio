<mxfile host="app.diagrams.net">
  <diagram id="seq_auth" name="Sequence - Auth Flow">
    <mxGraphModel dx="1200" dy="750" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="750" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Sequence Diagram: User Login &amp; Session Authentication" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="30" y="15" width="420" height="25" as="geometry"/>
        </mxCell>

        <!-- Lifelines -->
        <mxCell id="lf_browser" value="Browser&#xa;(login.html / api.js)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=0;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F5F5F5;strokeColor=#000000;strokeWidth=1;fontFamily=Arial;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="130" height="600" as="geometry"/>
        </mxCell>
        <mxCell id="lf_route" value="auth.py&#xa;(/api/auth/login)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=0;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F5F5F5;strokeColor=#000000;strokeWidth=1;fontFamily=Arial;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="230" y="60" width="130" height="600" as="geometry"/>
        </mxCell>
        <mxCell id="lf_svc" value=":AuthService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=0;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F5F5F5;strokeColor=#000000;strokeWidth=1;fontFamily=Arial;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="430" y="60" width="110" height="600" as="geometry"/>
        </mxCell>
        <mxCell id="lf_sec" value="security.py" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=0;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F5F5F5;strokeColor=#000000;strokeWidth=1;fontFamily=Arial;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="610" y="60" width="100" height="600" as="geometry"/>
        </mxCell>
        <mxCell id="lf_repo" value=":UserRepository" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=0;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F5F5F5;strokeColor=#000000;strokeWidth=1;fontFamily=Arial;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="780" y="60" width="120" height="600" as="geometry"/>
        </mxCell>
        <mxCell id="lf_db" value="MongoDB" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=0;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F5F5F5;strokeColor=#000000;strokeWidth=1;fontFamily=Arial;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="960" y="60" width="100" height="600" as="geometry"/>
        </mxCell>

        <!-- Activations -->
        <mxCell id="act_b" value="" style="html=0;points=[];perimeter=orthogonalPerimeter;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="130" width="10" height="460" as="geometry"/>
        </mxCell>
        <mxCell id="act_r" value="" style="html=0;points=[];perimeter=orthogonalPerimeter;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="140" width="10" height="430" as="geometry"/>
        </mxCell>
        <mxCell id="act_s" value="" style="html=0;points=[];perimeter=orthogonalPerimeter;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="210" width="10" height="310" as="geometry"/>
        </mxCell>

        <!-- Messages -->
        <mxCell id="m1" value="1: POST /api/auth/login {email, password}" style="html=0;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#000000;strokeWidth=1;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="110" y="145" as="sourcePoint"/><mxPoint x="290" y="145" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m2" value="2: auth_limiter.check(key)" style="html=0;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#000000;strokeWidth=1;fontFamily=Arial;fontSize=11;fontColor=#000000;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="300" y="165" as="sourcePoint"/><mxPoint x="300" y="190" as="targetPoint"/><Array as="points"><mxPoint x="350" y="165"/><mxPoint x="350" y="190"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="m3" value="3: login(email, password)" style="html=0;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#000000;strokeWidth=1;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="300" y="215" as="sourcePoint"/><mxPoint x="480" y="215" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m4" value="4: by_email(email)" style="html=0;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#000000;strokeWidth=1;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="490" y="245" as="sourcePoint"/><mxPoint x="835" y="245" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m5" value="5: users.find_one({email})" style="html=0;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#000000;strokeWidth=1;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="845" y="265" as="sourcePoint"/><mxPoint x="1005" y="265" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m6" value="6: user doc" style="html=0;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;strokeColor=#000000;strokeWidth=1;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="835" y="300" as="sourcePoint"/><mxPoint x="490" y="300" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m7" value="7: verify_password(password, hash)" style="html=0;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#000000;strokeWidth=1;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="490" y="335" as="sourcePoint"/><mxPoint x="655" y="335" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m8" value="8: True" style="html=0;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;strokeColor=#000000;strokeWidth=1;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="655" y="365" as="sourcePoint"/><mxPoint x="490" y="365" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m9" value="9: new_token() &amp; token_digest(token)" style="html=0;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#000000;strokeWidth=1;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="490" y="400" as="sourcePoint"/><mxPoint x="655" y="400" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m10" value="10: add_session(token_hash, user_id, expires)" style="html=0;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#000000;strokeWidth=1;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="490" y="445" as="sourcePoint"/><mxPoint x="835" y="445" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m11" value="11: sessions.insert_one(...)" style="html=0;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#000000;strokeWidth=1;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="845" y="465" as="sourcePoint"/><mxPoint x="1005" y="465" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m12" value="12: (user, token, expires)" style="html=0;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;strokeColor=#000000;strokeWidth=1;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="480" y="510" as="sourcePoint"/><mxPoint x="300" y="510" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m13" value="13: Set-Cookie: tc_session=token (HttpOnly, SameSite=Lax)" style="html=0;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;strokeColor=#000000;strokeWidth=1;fontFamily=Arial;fontSize=11;fontColor=#000000;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="290" y="560" as="sourcePoint"/><mxPoint x="110" y="560" as="targetPoint"/></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
